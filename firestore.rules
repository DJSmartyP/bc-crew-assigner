rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.uid == "tG8hNmlYRSd9RBiHe6WUEWFeZ173";
    }
    function isVerifiedEmailUser() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function isOrganiser() {
      return signedIn() && exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }
    function ownsMission(missionId) {
      return signedIn() && get(/databases/$(database)/documents/missions/$(missionId)).data.ownerUid == request.auth.uid;
    }

    match /profiles/{uid} {
      allow create: if isVerifiedEmailUser()
                    && request.auth.uid == uid
                    && request.resource.data.role == "organiser";
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow update: if isAdmin() || (
        isVerifiedEmailUser()
        && request.auth.uid == uid
        && resource.data.role == "organiser"
        && request.resource.data.role == "organiser"
      );
      allow delete: if isAdmin();
    }

    // Human-readable player links resolve through a single small lookup document.
    // Direct deployment-ID links remain supported for existing deployments.
    match /inviteLinks/{slug} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isAdmin() || (
        isOrganiser()
        && request.resource.data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/missions/$(request.resource.data.missionId)).data.ownerUid == request.auth.uid
      );
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.missionId == resource.data.missionId
      );
      allow delete: if isAdmin() || (
        signedIn() && resource.data.ownerUid == request.auth.uid
      );
    }

    match /missions/{missionId} {
      allow create: if isAdmin() || (
        isOrganiser()
        && request.resource.data.ownerUid == request.auth.uid
      );

      // Players need the mission settings to display the invite page and live roster.
      allow read: if signedIn();

      allow update, delete: if isAdmin() || (
        signedIn() && resource.data.ownerUid == request.auth.uid
      );

      match /players/{playerId} {
        // The shared roster is readable to signed-in mission visitors so the live
        // suggested crew can be calculated in the browser.
        allow read: if signedIn();

        function validPlayerShape() {
          return request.resource.data.keys().hasOnly([
                   "name", "shipPref", "prefs", "dislikes", "source",
                   "createdAt", "priorityAt", "updatedAt"
                 ])
                 && request.resource.data.name is string
                 && request.resource.data.shipPref is string
                 && request.resource.data.prefs is list
                 && request.resource.data.prefs.size() == 3
                 && request.resource.data.dislikes is list;
        }

        function preferencesChanged() {
          return request.resource.data.shipPref != resource.data.shipPref
                 || request.resource.data.prefs != resource.data.prefs
                 || request.resource.data.dislikes != resource.data.dislikes;
        }

        function playerCanCreateOwn() {
          return signedIn()
                 && request.auth.uid == playerId
                 && validPlayerShape()
                 && request.resource.data.source == "player"
                 && request.resource.data.createdAt == request.time
                 && request.resource.data.priorityAt == request.time
                 && request.resource.data.updatedAt == request.time;
        }

        function playerCanUpdateOwn() {
          return signedIn()
                 && request.auth.uid == playerId
                 && validPlayerShape()
                 && request.resource.data.source == "player"
                 && request.resource.data.createdAt == resource.data.createdAt
                 && request.resource.data.updatedAt == request.time
                 && (
                   (preferencesChanged() && request.resource.data.priorityAt == request.time)
                   || (!preferencesChanged() && request.resource.data.priorityAt == resource.data.priorityAt)
                 );
        }

        allow create: if isAdmin() || ownsMission(missionId) || playerCanCreateOwn();
        allow update: if isAdmin() || ownsMission(missionId) || playerCanUpdateOwn();
        allow delete: if isAdmin() || ownsMission(missionId);
      }

      // One claim per normalised player name prevents duplicate registrations.
      // Owners need list access so deployment deletion can remove every claim.
      match /nameClaims/{claimId} {
        function validClaimShape() {
          return request.resource.data.keys().hasOnly([
                   "playerId", "name", "updatedAt"
                 ])
                 && request.resource.data.playerId is string
                 && request.resource.data.name is string
                 && request.resource.data.updatedAt == request.time;
        }

        function playerCanCreateOwnClaim() {
          return signedIn()
                 && validClaimShape()
                 && request.resource.data.playerId == request.auth.uid;
        }

        function playerCanUpdateOwnClaim() {
          return signedIn()
                 && validClaimShape()
                 && resource.data.playerId == request.auth.uid
                 && request.resource.data.playerId == request.auth.uid;
        }

        allow get: if signedIn();
        allow list: if isAdmin() || ownsMission(missionId);
        allow create: if isAdmin() || ownsMission(missionId) || playerCanCreateOwnClaim();
        allow update: if isAdmin() || ownsMission(missionId) || playerCanUpdateOwnClaim();
        allow delete: if isAdmin() || ownsMission(missionId) || (
          signedIn() && resource.data.playerId == request.auth.uid
        );
      }
    }
  }
}
